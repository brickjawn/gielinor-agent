# Copy to .env and edit. .env is gitignored; this file is not.
# Everything here has a safe default — the agent runs with none of it set.

# --- slow loop ------------------------------------------------------------
# Unprefixed on purpose: it is what every other tool on the machine calls it.
# Without a key the agent still runs; the reflex planner needs no network and
# escalations are simply skipped.
# OPENROUTER_API_KEY=sk-or-v1-...
#
# Three other ways to supply it, in the order they are consulted. Prefer a file
# over this variable anywhere that isn't your own dev box: env vars show up in
# `docker inspect`, in /proc/<pid>/environ, in crash dumps, and are inherited by
# every child process. See docs/deployment.md.
#
#   OPENROUTER_API_KEY_FILE=/path/to/key   # the _FILE convention
#   /run/secrets/openrouter_api_key        # Docker Compose secret, tmpfs-backed
#   GIELINOR_SECRETS_DIR=/somewhere/else   # move where the above is looked for
#
# Write the file with printf, not echo — a trailing newline produces a 401 that
# is indistinguishable from a wrong key:
#   printf '%s' "$OPENROUTER_API_KEY" > secrets/openrouter_api_key

# --- capture --------------------------------------------------------------
# auto | replay | pipewire | screencapturekit
GIELINOR_CAPTURE__BACKEND=auto
GIELINOR_CAPTURE__FPS=20
# Where `auto` falls back to when there is no display (and what CI uses).
# GIELINOR_CAPTURE__REPLAY_DIR=captures/willows

# --- actuator -------------------------------------------------------------
# dryrun is the default and stays the default. Setting this to uinput/quartz is
# NOT sufficient on its own: the constructor also demands allow_real_input=True
# at the call site, which is deliberate.
GIELINOR_ACTUATOR__BACKEND=dryrun
GIELINOR_ACTUATOR__ALLOW_REAL_INPUT=0
GIELINOR_ACTUATOR__ALLOW_CHAT=0
GIELINOR_ACTUATOR__PROFILE=2009scape_fixed

# --- runtime --------------------------------------------------------------
GIELINOR_RUNTIME__TARGET_HZ=15
GIELINOR_RUNTIME__FRAME_BUDGET_MS=50
GIELINOR_RUNTIME__MAX_STALE_FRAMES=30
GIELINOR_RUNTIME__MAX_STALE_S=3.0
# GIELINOR_RUNTIME__TRACE_PATH=traces/run.jsonl

# --- planner --------------------------------------------------------------
GIELINOR_PLANNER__TIMEOUT_S=20
GIELINOR_PLANNER__MAX_RETRIES=3
GIELINOR_PLANNER__ESCALATION_COOLDOWN_S=3.0

GIELINOR_LOG_LEVEL=INFO
